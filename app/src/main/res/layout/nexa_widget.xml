<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="#101827">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Nexa · امروز" android:textColor="#6EE7B7" android:textStyle="bold" android:textSize="14sp" />
    <TextView android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center_vertical" android:text="کار بعدی" android:textColor="#FFFFFF"
        android:textSize="16sp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/widget_time" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Nexa را باز کن" android:textColor="#AAB7CB" android:textSize="13sp" />
</LinearLayout>
